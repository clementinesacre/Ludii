
(define "MoveNextToDisc"
	(move 
		(from (sites Hand Shared))
		(to 
			(sites Around (sites Occupied by:All components:{"DiscRed" "DiscBlue" "DiscGreen" "DiscOrange" "DiscYellow" "DiscPurple"}) Orthogonal if:(is Empty (to)))
		)
	)
)

(define "MoveNextToStar"
	(move 
		(from (sites Hand Shared))
		(to 
			(sites Around (sites Occupied by:All components:{"StarRed" "StarBlue" "StarGreen" "StarOrange" "StarYellow" "StarPurple"}) Orthogonal if:(is Empty (to)))
		)
	)
)


(define "MoveNextToRed"
	(move 
		(from (sites Hand Shared))
		(to 
			(sites Around (sites Occupied by:All components:{"DiscRed" "StarRed"}) Orthogonal if:(is Empty (to)))
		)
	)
)

(define "MoveNextToBlue"
	(move 
		(from (sites Hand Shared))
		(to 
			(sites Around (sites Occupied by:All components:{"DiscBlue" "StarBlue"}) Orthogonal if:(is Empty (to)))
		)
	)
)

(define "MoveNextToGreen"
	(move 
		(from (sites Hand Shared))
		(to 
			(sites Around (sites Occupied by:All components:{"DiscGreen" "StarGreen"}) Orthogonal if:(is Empty (to)))
		)
	)
)

(define "MoveNextToOrange"
	(move 
		(from (sites Hand Shared))
		(to 
			(sites Around (sites Occupied by:All components:{"DiscOrange" "StarOrange"}) Orthogonal if:(is Empty (to)))
		)
	)
)

(define "MoveNextToYellow"
	(move 
		(from (sites Hand Shared))
		(to 
			(sites Around (sites Occupied by:All components:{"DiscYellow" "StarYellow"}) Orthogonal if:(is Empty (to)))
		)
	)
)

(define "MoveNextToPurple"
	(move 
		(from (sites Hand Shared))
		(to 
			(sites Around (sites Occupied by:All components:{"DiscPurple" "StarPurple"}) Orthogonal if:(is Empty (to)))
		)
	)
)


//-----------------------------------------------
// Main routine

(game "Qwirkle" 
    (players 2) 
    (equipment { 
        (boardless Square 5) 
        
        (hand Shared size:13)
        
        (piece "starOutline" Shared (or {"MoveNextToDisc" "MoveNextToRed"}))
        
        (tile "DiscRed" numSides:4 (or {"MoveNextToDisc" "MoveNextToRed"}))
        (tile "DiscBlue" numSides:4 (or {"MoveNextToDisc" "MoveNextToBlue"}))
        (tile "DiscGreen" numSides:4 (or {"MoveNextToDisc" "MoveNextToGreen"}))
        (tile "DiscOrange" numSides:4 (or {"MoveNextToDisc" "MoveNextToOrange"}))
        (tile "DiscYellow" numSides:4 (or {"MoveNextToDisc" "MoveNextToYellow"}))
        (tile "DiscPurple" numSides:4 (or {"MoveNextToDisc" "MoveNextToPurple"}))
        (tile "StarRed" numSides:4 (or {"MoveNextToStar" "MoveNextToRed"}))
        (tile "StarBlue" numSides:4 (or {"MoveNextToStar" "MoveNextToBlue"}))
        (tile "StarGreen" numSides:4 (or {"MoveNextToStar" "MoveNextToGreen"}))
        (tile "StarOrange" numSides:4 (or {"MoveNextToStar" "MoveNextToOrange"}))
        (tile "StarYellow" numSides:4 (or {"MoveNextToStar" "MoveNextToYellow"}))
        (tile "StarPurple" numSides:4 (or {"MoveNextToStar" "MoveNextToPurple"}))
    }) 
    
    (rules 
   		(start {
        	(place "starOutline" (handSite Shared 12) count:3)
        	
        	(place "DiscRed" (handSite Shared 0) count:3)
        	(place "DiscBlue" (handSite Shared 1) count:3)
        	(place "DiscGreen" (handSite Shared 2) count:3)
        	(place "DiscOrange" (handSite Shared 3) count:3)
        	(place "DiscYellow" (handSite Shared 4) count:3)
        	(place "DiscPurple" (handSite Shared 5) count:3)
        	(place "StarRed" (handSite Shared 6) count:3)
        	(place "StarBlue" (handSite Shared 7) count:3)
        	(place "StarGreen" (handSite Shared 8) count:3)
        	(place "StarOrange" (handSite Shared 9) count:3)
        	(place "StarYellow" (handSite Shared 10) count:3)
        	(place "StarPurple" (handSite Shared 11) count:3)
        })
        
        
        phases:{
	        (phase "Opening"
	            (play     	
	            	(move 
		        		(from (sites Hand Shared))
		        		(to (sites Playable))
		        	)
	            )
	            
	            (nextPhase "Connection")
	        )
	        
	        (phase "Connection"
	            (play
	            (or {
				 	(if (= (site) (var "DiscRed")) "MoveNextToRed")
				 	(if (= (site) (var "DiscBlue")) "MoveNextToBlue")
				 })
				 
				)
	            
	            (end ("NoMoves" Loss))
	        )
        }
        
        //(end ("Line3Win"))
    )
)
//------------------------------------------------------------------------------

(option "Players" <Players> args:{ <nb> }
{
	 (item "2 players" <2> "The game has two players.")
	 (item "3 players" <3> "The game has three players.")**
	 (item "4 players" <4> "The game has four players.")
})


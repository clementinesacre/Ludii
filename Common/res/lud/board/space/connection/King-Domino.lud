        (piece Colour "TileForest" fillColour:(colour 76 117 62))
        (piece Colour "TileField" fillColour:(colour 249 215 73))
        (piece Colour "TileSwamp" fillColour:(colour 192 190 163))
        (piece Colour "TileMine" fillColour:(colour 55 55 50))
        (piece Colour "TileGrassland" fillColour:(colour 209 214 80))
        
        (piece Foreground "TileLakeCrown" image:"Pawn" fillColour:(colour 68 152 214) edgeColour:(colour 0 0 0 0))
        (piece Foreground "TileForestCrown" image:"Pawn" fillColour:(colour 76 117 62) edgeColour:(colour 0 0 0 0))
        (piece Foreground "TileFieldCrown" image:"Pawn" fillColour:(colour 249 215 73) edgeColour:(colour 0 0 0 0))
        (piece Foreground "TileSwampCrown" image:"Pawn" fillColour:(colour 192 190 163) edgeColour:(colour 0 0 0 0))
        (piece Foreground "TileMineCrown" image:"Pawn" fillColour:(colour 55 55 50) edgeColour:(colour 0 0 0 0))
        (piece Foreground "TileGrasslandCrown" image:"Pawn" fillColour:(colour 209 214 80) edgeColour:(colour 0 0 0 0))
        
        (board Style Board)
    })
    
)

(define "MoveTileNextToSameTileOrCastle"
	(move 
		(from (handSite Shared #1))
    	(to 
    		(sites Around (sites Occupied by:All components:{#2 #3 "TileCastle"}) Orthogonal if:(is Empty (to)))
    	) 
    	copy:True
	)
)

(define "PlaceATileTo" 
    (or {
        ("MoveTileNextToSameTileOrCastle" 0 "TileLake" "TileLakeCrown")
        ("MoveTileNextToSameTileOrCastle" 1 "TileForest" "TileForestCrown")
        ("MoveTileNextToSameTileOrCastle" 2 "TileField" "TileFieldCrown")
        ("MoveTileNextToSameTileOrCastle" 3 "TileSwamp" "TileSwampCrown")
        ("MoveTileNextToSameTileOrCastle" 4 "TileMine" "TileMineCrown")
        ("MoveTileNextToSameTileOrCastle" 5 "TileGrassland" "TileGrasslandCrown")
        ("MoveTileNextToSameTileOrCastle" 6 "TileLakeCrown" "TileLake")
        ("MoveTileNextToSameTileOrCastle" 7 "TileForestCrown" "TileForest")
        ("MoveTileNextToSameTileOrCastle" 8 "TileFieldCrown" "TileField")
        ("MoveTileNextToSameTileOrCastle" 9 "TileSwampCrown" "TileSwamp")
        ("MoveTileNextToSameTileOrCastle" 10 "TileMineCrown" "TileMine")
        ("MoveTileNextToSameTileOrCastle" 11 "TileGrasslandCrown" "TileGrassland")
    })
)

//------------------------------------------------------------------------------

(game "King-Domino" 
    (players <Players:nbrPlayer>) 
    (equipment { 
        (boardless Square 11) 
        (hand Shared size:12)
        
        (tile "TileCastle" numSides:4)
        
        (tile "TileLake" numSides:4)
        (tile "TileField" numSides:4)
        (tile "TileSwamp" numSides:4)
        (tile "TileForest" numSides:4)
        (tile "TileMine" numSides:4)
        (tile "TileGrassland" numSides:4)
        (tile "TileLakeCrown" numSides:4)
        (tile "TileFieldCrown" numSides:4)
        (tile "TileSwampCrown" numSides:4)
        (tile "TileForestCrown" numSides:4)
        (tile "TileMineCrown" numSides:4)
        (tile "TileGrasslandCrown" numSides:4)
    }) 
    (rules         
        (start {
        	(place "TileCastle" (centrePoint))
        	
            (place "TileLake" (handSite Shared)) 
            (place "TileForest" (handSite Shared 1))
            (place "TileField" (handSite Shared 2))
            (place "TileSwamp" (handSite Shared 3))
            (place "TileMine" (handSite Shared 4))
            (place "TileGrassland" (handSite Shared 5))
            (place "TileLakeCrown" (handSite Shared 6)) 
            (place "TileForestCrown" (handSite Shared 7))
            (place "TileFieldCrown" (handSite Shared 8))
            (place "TileSwampCrown" (handSite Shared 9))
            (place "TileMineCrown" (handSite Shared 10))
            (place "TileGrasslandCrown" (handSite Shared 11))
        })
        
        (play  
       		("PlaceATileTo")
        )
        
        (end {
            (if (= (count Moves) <Players:rounds>) (result Mover Win))
        })
        
    )
)

//------------------------------------------------------------------------------

(option "Players" <Players> args:{<nbrPlayer> <rounds>} 
    {
    (item "One player" <1> <12> "The game is played with one player.")** //todo : delete this - for test only
    (item "Two players" <2> <6> "The game is played with two players.")
    (item "Three players" <3> <12> "The game is played with three players.")
    (item "Four players" <4> <12> "The game is played with four players.")
    }
)

